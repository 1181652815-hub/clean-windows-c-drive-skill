<Window x:Class="CDriveManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="C盘空间管理" Width="1200" Height="780" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F4F7FC"
        FontFamily="Microsoft YaHei UI" Loaded="Window_Loaded">
  <Window.Resources>
    <SolidColorBrush x:Key="Primary" Color="#2F5BFF"/>
    <SolidColorBrush x:Key="Text" Color="#172033"/>
    <SolidColorBrush x:Key="SubText" Color="#68758A"/>
    <SolidColorBrush x:Key="Line" Color="#DDE4EF"/>
    <Style TargetType="Button">
      <Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="18,10"/><Setter Property="MinWidth" Value="88"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#CDD6E5"/>
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="14,4"/>
      <Setter Property="Padding" Value="18,15"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E8EDF5"/>
      <Setter Property="RowHeight" Value="40"/><Setter Property="ColumnHeaderHeight" Value="40"/>
      <Setter Property="CanUserAddRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="False"/><Setter Property="SelectionMode" Value="Extended"/>
      <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#234BE8">
      <Grid Margin="26,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="C盘空间管理" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock Text="安全扫描 · 精确处理 · 结果可核对" Foreground="#C8D4FF" FontSize="12" Margin="18,6,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#315AF0" Padding="16,8" VerticalAlignment="Center">
          <TextBlock x:Name="HealthText" Text="正在检测 C 盘…" Foreground="White" FontSize="13"/>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="24,25,20,16">
            <TextBlock Text="功能" FontSize="13" Foreground="{StaticResource SubText}"/>
            <TextBlock Text="三个核心模块" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <Button x:Name="NavJunk" Style="{StaticResource NavButton}" Content="01   垃圾清理" Click="NavJunk_Click"/>
            <Button x:Name="NavLarge" Style="{StaticResource NavButton}" Content="02   查找大文件" Click="NavLarge_Click"/>
            <Button x:Name="NavDuplicate" Style="{StaticResource NavButton}" Content="03   重复文件" Click="NavDuplicate_Click"/>
          </StackPanel>
          <Border Grid.Row="2" Margin="18" Padding="15" Background="#EFF3FF" BorderBrush="#D8E1FF" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="安全边界" FontWeight="SemiBold" Foreground="#234BE8"/>
              <TextBlock Text="不处理系统目录、软件配置、云盘占位文件和未勾选的个人文件。" TextWrapping="Wrap" Foreground="#59677C" FontSize="12" LineHeight="20" Margin="0,7,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="25">
        <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="22,16">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="本地磁盘 (C:)" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
              <TextBlock x:Name="DriveSummary" Text="正在读取容量…" Foreground="{StaticResource SubText}" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <ProgressBar x:Name="DriveUsageBar" Height="11" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource Primary}" Background="#E5EAF2"/>
              <TextBlock x:Name="DriveUsageText" Text="0% 已用" HorizontalAlignment="Right" Foreground="{StaticResource SubText}" Margin="0,7,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="JunkPanel" Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,17,0,0" Padding="25">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="垃圾清理" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                <TextBlock Text="只扫描可再生缓存和旧诊断文件，扫描完成后再确认清理。" Foreground="{StaticResource SubText}" Margin="0,7,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="扫描已选" Style="{StaticResource PrimaryButton}" Click="ScanJunk_Click" Margin="0,0,10,0"/>
                <Button x:Name="CleanJunkButton" Content="清理扫描项" Style="{StaticResource PrimaryButton}" Click="CleanJunk_Click" IsEnabled="False"/>
              </StackPanel>
            </Grid>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,25,0,17">
              <CheckBox x:Name="JunkTemp" Content="用户临时文件" Margin="0,9"/>
              <CheckBox x:Name="JunkShader" Content="着色器缓存" Margin="0,9"/>
              <CheckBox x:Name="JunkBrowser" Content="浏览器纯缓存" Margin="0,9"/>
              <CheckBox x:Name="JunkCrash" Content="旧崩溃转储" Margin="0,9"/>
              <CheckBox x:Name="JunkReports" Content="旧错误报告" Margin="0,9"/>
              <CheckBox x:Name="JunkInstaller" Content="安装器临时文件" Margin="0,9"/>
              <CheckBox x:Name="JunkComponents" Content="Windows 组件清理（管理员）" Margin="0,9"/>
              <CheckBox x:Name="JunkDelivery" Content="传递优化缓存（管理员）" Margin="0,9"/>
            </UniformGrid>
            <Border Grid.Row="2" Height="1" Background="{StaticResource Line}"/>
            <TextBox x:Name="JunkResult" Grid.Row="3" Margin="0,17,0,0" Padding="16" Background="#F7F9FC" BorderThickness="0"
                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Text="请选择需要检查的小类目，然后点击“扫描已选”。扫描阶段不会删除任何文件。"/>
          </Grid>
        </Border>

        <Border x:Name="LargePanel" Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,17,0,0" Padding="25" Visibility="Collapsed">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="查找并清理大文件" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                <TextBlock Text="仅扫描当前用户在 C 盘的桌面、下载、文档、图片、视频和音乐。" Foreground="{StaticResource SubText}" Margin="0,7,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="最小" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="LargeMinimum" Text="500" Width="64" Padding="6"/>
                <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,14,0"/>
                <Button Content="开始扫描" Style="{StaticResource PrimaryButton}" Click="ScanLarge_Click" Margin="0,0,10,0"/>
                <Button x:Name="CleanLargeButton" Content="移至回收站" Style="{StaticResource PrimaryButton}" Click="CleanLarge_Click" IsEnabled="False"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="LargeSummary" Grid.Row="1" Text="扫描结果默认不选择，请核对路径和大小。" Foreground="{StaticResource SubText}" Margin="0,19,0,12"/>
            <DataGrid x:Name="LargeGrid" Grid.Row="2">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选择" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="58"/>
                <DataGridTextColumn Header="类型" Binding="{Binding Category}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="大小 (GB)" Binding="{Binding SizeGiB}" IsReadOnly="True" Width="95"/>
                <DataGridTextColumn Header="修改时间" Binding="{Binding LastWriteTime}" IsReadOnly="True" Width="145"/>
                <DataGridTextColumn Header="路径" Binding="{Binding Path}" IsReadOnly="True" Width="*" MinWidth="300"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <Border x:Name="DuplicatePanel" Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,17,0,0" Padding="25" Visibility="Collapsed">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="重复文件清理" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                <TextBlock Text="先比较大小，再用 SHA-256 确认内容一致；每组至少保留一份。" Foreground="{StaticResource SubText}" Margin="0,7,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="最小" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="DuplicateMinimum" Text="10" Width="64" Padding="6"/>
                <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,14,0"/>
                <Button Content="开始扫描" Style="{StaticResource PrimaryButton}" Click="ScanDuplicate_Click" Margin="0,0,10,0"/>
                <Button x:Name="CleanDuplicateButton" Content="移至回收站" Style="{StaticResource PrimaryButton}" Click="CleanDuplicate_Click" IsEnabled="False"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="DuplicateSummary" Grid.Row="1" Text="扫描结果默认不选择，请逐组保留至少一个文件。" Foreground="{StaticResource SubText}" Margin="0,19,0,12"/>
            <DataGrid x:Name="DuplicateGrid" Grid.Row="2">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选择" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="58"/>
                <DataGridTextColumn Header="组" Binding="{Binding Group}" IsReadOnly="True" Width="68"/>
                <DataGridTextColumn Header="类型" Binding="{Binding Category}" IsReadOnly="True" Width="105"/>
                <DataGridTextColumn Header="大小 (GB)" Binding="{Binding SizeGiB}" IsReadOnly="True" Width="95"/>
                <DataGridTextColumn Header="修改时间" Binding="{Binding LastWriteTime}" IsReadOnly="True" Width="140"/>
                <DataGridTextColumn Header="路径" Binding="{Binding Path}" IsReadOnly="True" Width="*" MinWidth="280"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#E9EEF6" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="就绪｜所有处理都需要先扫描并确认" VerticalAlignment="Center" Foreground="#5C697C" FontSize="12"/>
        <TextBlock Grid.Column="1" Text="v3.0.1" VerticalAlignment="Center" Foreground="#7B8798" FontSize="12"/>
      </Grid>
    </Border>
  </Grid>
</Window>
